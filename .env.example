# Copy to .env (gitignored) and fill in real values.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://ulaw_user:ulaw_pass@postgres:5432/ulaw_portal?schema=public"

# ── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<paste-32-byte-base64>"
NEXTAUTH_URL="https://portal.example.com"
AUTH_SECRET="<same-as-NEXTAUTH_SECRET>"
AUTH_URL="https://portal.example.com"

# ── Google OAuth (Sign in with Google) ────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Google Calendar API ───────────────────────────────────────
GOOGLE_CALENDAR_REDIRECT_URI="https://portal.example.com/api/calendar/google/callback"

# ── Admin seed (used by prisma/seed.ts) ───────────────────────
ADMIN_EMAIL="admin@example.edu.vn"
ADMIN_PASSWORD="<change-me>"

# ── Email (optional, nodemailer SMTP) ─────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# ── Tuning ────────────────────────────────────────────────────
BCRYPT_COST="12"
STUDENT_EMAIL_DOMAIN="email.hcmulaw.edu.vn"
