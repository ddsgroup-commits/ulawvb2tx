# ─────────────────────────────────────────────────────────────
#  ULAW VB2-TX LMS · v2.1 environment template
#  Copy to `.env` (dev) and `.env.prod` (VPS) and fill in.
# ─────────────────────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_APP_URL=https://ulawvb2tx.com
NODE_ENV=production

# ── Database ──
DATABASE_URL=postgresql://ulaw:CHANGE_ME@db:5432/ulaw_lms?schema=public

# ── NextAuth ──
# Generate: `openssl rand -base64 32`
AUTH_SECRET=CHANGE_ME
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://ulawvb2tx.com

# ── Google OAuth (optional, but recommended) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Token encryption (AES-256-GCM, lib/crypto.ts) ──
# Generate: `openssl rand -hex 32`
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── Gemini AI (Trợ lý học tập) ──
GOOGLE_API_KEY=

# ── SMTP for transactional email (lib/email.ts) ──
# Leave SMTP_HOST blank to no-op email sending (in-app + push still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ULAW VB2-TX <noreply@ulawvb2tx.com>"

# ── Web Push (VAPID) ──
# Generate keys: `npm run vapid:keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@ulawvb2tx.com

# ── File uploads (Phase 4 — VPS local storage) ──
UPLOAD_DIR=/var/ulaw-uploads
UPLOAD_MAX_BYTES=20971520
